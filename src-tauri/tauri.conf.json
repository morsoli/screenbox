{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Screenbox",
  "version": "0.1.0",
  "identifier": "com.morso.screenbox",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build:web",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [{ "label": "main", "title": "Screenbox", "width": 1280, "height": 800, "minWidth": 900, "minHeight": 620 }],
    "security": {
      "csp": null,
      "assetProtocol": { "enable": true, "scope": ["$APPDATA/**"] }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns"],
    "resources": ["resources/screenbox-capture", "resources/whisper-cli"],
    "macOS": { "minimumSystemVersion": "15.0", "infoPlist": "Info.plist" }
  }
}
